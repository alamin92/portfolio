---
import Base from '../../layouts/Base.astro';
---

<Base title="Memory Match" description="A memory card game using Alamin Hossain's travel photos.">
  <div class="page">
    <div class="container">
      <p><a href="/arcade">← Arcade</a></p>
      <h1>Memory Match</h1>
      <p class="lead">Flip two cards at a time and find the matching photos. They're all from my trips.</p>

      <div class="scores">
        <span>Moves: <strong id="moves">0</strong></span>
        <span>Best: <strong id="best">–</strong></span>
        <button id="new" type="button" class="btn">New game</button>
      </div>

      <div id="board" class="mm-board" role="group" aria-label="Memory cards"></div>
      <p id="status" class="muted" role="status" aria-live="polite"></p>
    </div>
  </div>
</Base>

<script>
  import { initMemory } from '../../scripts/memory';

  initMemory(
    document.getElementById('board')!,
    document.getElementById('moves')!,
    document.getElementById('best')!,
    document.getElementById('status')!,
    document.getElementById('new')!,
  );
</script>

<style>
  .scores { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 24px; margin-bottom: 14px; }
  .scores .btn { padding: 6px 14px; margin-left: auto; }
</style>

<!-- Cards are created by script, so their styles must be global (Astro scopes the rest). -->
<style is:global>
  .mm-board {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    width: min(480px, 100%);
  }
  .mm-card {
    padding: 0;
    border: 0;
    background: none;
    aspect-ratio: 1;
    perspective: 700px;
    cursor: pointer;
    border-radius: 10px;
  }
  .mm-card:disabled { cursor: default; }
  .mm-inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.4s;
  }
  .mm-open .mm-inner { transform: rotateY(180deg); }
  .mm-face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .mm-back {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--accent-text);
    background: var(--accent);
  }
  .mm-card:hover:not(:disabled) .mm-back { filter: brightness(1.1); }
  .mm-front {
    object-fit: cover;
    transform: rotateY(180deg);
    border: 1px solid var(--border);
  }
  .mm-matched .mm-front { outline: 3px solid #22c55e; outline-offset: -3px; }
  .mm-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
