---
import Base from '../../layouts/Base.astro';
import { albums } from '../../data/photos';
import { placeCategories } from '../../data/places';

const photoCount = albums.reduce((n, a) => n + a.photos.length, 0);
const placeCount = placeCategories.reduce((n, c) => n + c.items.length, 0);
// A few thumbnails to preview the photos card.
const preview = albums.flatMap((a) => a.photos.slice(0, 1)).slice(0, 4);
---

<Base title="Travel" description="Photos, places and trip-planning tools from Alamin Hossain's hikes and road trips.">
  <div class="page">
    <div class="container">
      <h1>Travel</h1>
      <p class="lead">
        Mountains, canyons, waterfalls and quiet coastlines. Here are my photos, the places I love
        (and the ones I still want to see), and the tools I use to plan.
      </p>

      <div class="doors">
        <a class="card door" href="/travel/photos">
          <div class="thumbs" aria-hidden="true">
            {preview.map((p) => <img src={p.thumb} width={p.tw} height={p.th} alt="" loading="lazy" />)}
          </div>
          <h2>Photos</h2>
          <p class="muted">{photoCount} photos from {albums.length} albums.</p>
          <span class="go">Browse →</span>
        </a>
        <a class="card door" href="/travel/places">
          <h2>Places</h2>
          <p class="muted">
            {placeCount} places in {placeCategories.length} categories: national parks, state parks,
            hikes, waterfalls, hidden gems and more. Each opens in Google Maps.
          </p>
          <span class="go">Explore →</span>
        </a>
        <a class="card door" href="/travel/plan">
          <h2>Plan a trip</h2>
          <p class="muted">NPS, AllTrails, I LOVE NY, Kayak, Airbnb and the other sites I use.</p>
          <span class="go">See the list →</span>
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
  .doors { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); margin-top: 28px; }
  .door { color: var(--text); transition: border-color 0.15s, transform 0.15s; display: flex; flex-direction: column; }
  .door:hover { text-decoration: none; border-color: var(--accent); transform: translateY(-2px); }
  .door h2 { margin: 0 0 6px; font-size: 1.4rem; }
  .door p { margin: 0 0 16px; flex: 1; }
  .go { color: var(--accent); font-weight: 600; }
  .thumbs { display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px; margin-bottom: 14px; border-radius: 8px; overflow: hidden; }
  .thumbs img { width: 100%; height: 80px; object-fit: cover; display: block; }
</style>
