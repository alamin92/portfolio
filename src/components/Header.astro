---
import { site, nav } from '../config';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header>
  <div class="container bar">
    <a class="brand" href="/">{site.name}</a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  header { border-bottom: 1px solid var(--border); }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-top: 16px;
    padding-bottom: 16px;
  }
  .brand { font-weight: 700; color: var(--text); letter-spacing: -0.02em; }
  .brand:hover { text-decoration: none; }
  ul { display: flex; flex-wrap: wrap; gap: 4px 20px; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--muted); font-size: 0.95rem; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); text-decoration: none; }
</style>
